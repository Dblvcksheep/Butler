TELEGRAM_BOT_TOKEN=
#BUTLER_ALLOWED_USERS=123456789          # comma-separated Telegram user ids
BUTLER_MASTER_KEY=                      # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BUTLER_OLD_MASTER_KEYS=                 # only during key rotation (comma-separated)
BUTLER_PUBLIC_URL=https://butler.example.com   # HTTPS URL of the web service (secure key/credential pages)
BUTLER_WEB_PORT=8080
BUTLER_GRAPH=on                         # off = run WITHOUT FalkorDB (degraded; see README ablation)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
DATABASE_URL=                           # postgresql://user:pass@host/db ; empty = SQLite file below
BUTLER_DB_PATH=butler.sqlite3
BUTLER_WORKER_MODE=inline               # inline (bot polls) | celery (run worker + beat)
REDIS_URL=redis://localhost:6379/1
TASK_POLL_SECONDS=30
PAYPAL_ENV=sandbox                      # live is refused unless BUTLER_ALLOW_LIVE=1
PAYMENT_MAX_PER_TX=50
PAYMENT_MAX_PER_DAY=100
EMAIL_DAILY_CAP=20                      # emails per user per 24h (Butler never sends without approval)
EMAIL_MAX_BATCH=10                      # emails per approved batch
# BRAVE_SEARCH_URL=                     # override the web search endpoint (verify against Brave's docs)
# Optional endpoint overrides (verify against each provider's docs):
# NEBIUS_BASE_URL=
# QWEN_BASE_URL=
# BUTLER_MCP_CONFIG=mcp_services.json   # extra/override MCP services (see README)
